import pandas as pd
import numpy as np
import faiss
import sqlite3
import json
import os
import requests
import hashlib
from datetime import datetime
from pathlib import Path
DATA_FILE = Path("patient_data.xlsx")
df = pd.read_excel(DATA_FILE)
print(f"✓ Loaded {len(df)} patient records from {DATA_FILE}")
print(f"Shape: {df.shape}\n")
print("Columns:", df.columns.tolist())
print(f"\nDataset Preview:")
print(df.head(3))

# Validate required columns
required_cols = ['patient_id', 'patient_name', 'age', 'diagnosis', 'missed_last_appointment', 
                 'vitals_bp_systolic', 'vitals_bp_diastolic', 'vitals_heart_rate', 'vitals_spo2', 
                 'days_since_last_visit', 'lab_test', 'lab_value', 'notes']
missing = [c for c in required_cols if c not in df.columns]
assert not missing, f"Missing columns: {missing}"
print(f"\n✓ Data validation passed")

df['last_visit_date'] = pd.to_datetime(df['last_visit_date'], errors='coerce')
df['next_scheduled_visit'] = pd.to_datetime(df['next_scheduled_visit'], errors='coerce')
df['missed_appointment_flag'] = (df['missed_last_appointment'].astype(str).str.strip().str.lower() == 'yes').astype(int)
df['is_overdue'] = df['days_since_last_visit'] > 30
df['high_bp'] = (df['vitals_bp_systolic'] > 140) | (df['vitals_bp_diastolic'] > 90)
df['low_spo2'] = df['vitals_spo2'] < 95
df['has_multiple_comorbidities'] = df['diagnosis'].str.contains(r'\+|,', regex=True, na=False).astype(int)

print("✓ Data Cleaning & Feature Engineering Complete")
print(f"\nClinical Summary:")
print(f"  Missed Appointments: {df['missed_appointment_flag'].sum()}")
print(f"  Overdue Patients (>30 days): {df['is_overdue'].sum()}")
print(f"  High BP (>140/90): {df['high_bp'].sum()}")
print(f"  Low SpO2 (<95%): {df['low_spo2'].sum()}")
print(f"  Multiple Comorbidities: {df['has_multiple_comorbidities'].sum()}")




import matplotlib.pyplot as plt
import seaborn as sns

fig, axes = plt.subplots(2, 3, figsize=(15, 10))
fig.suptitle('MediCare Patient Population - Clinical Risk Summary', fontsize=14, fontweight='bold')

diag_counts = df['diagnosis'].str.split(r'\+|,').explode().str.strip().value_counts().head(8)
axes[0, 0].barh(diag_counts.index, diag_counts.values, color='steelblue')
axes[0, 0].set_title('Top Diagnoses')
axes[0, 0].set_xlabel('Count')

axes[0, 1].hist(df['vitals_bp_systolic'], bins=20, alpha=0.7, color='red')
axes[0, 1].axvline(140, color='darkred', linestyle='--', label='Target (140)')
axes[0, 1].set_title('BP Distribution')
axes[0, 1].set_xlabel('Systolic (mmHg)')
axes[0, 1].legend()

missed_counts = df['missed_appointment_flag'].value_counts()
axes[0, 2].pie([missed_counts[0], missed_counts[1]], labels=['Attended', 'Missed'], autopct='%1.1f%%', colors=['green', 'orange'])
axes[0, 2].set_title('Appointment Adherence')

risk_matrix = pd.crosstab(df['high_bp'], df['low_spo2'])
sns.heatmap(risk_matrix, annot=True, fmt='d', cmap='RdYlGn_r', ax=axes[1, 0], cbar=False)
axes[1, 0].set_title('BP & SpO2 Risk Matrix')
axes[1, 0].set_ylabel('High BP')
axes[1, 0].set_xlabel('Low SpO2')

axes[1, 1].hist(df['days_since_last_visit'], bins=25, color='coral')
axes[1, 1].axvline(30, color='darkred', linestyle='--', label='Overdue (30d)')
axes[1, 1].set_title('Days Since Last Visit')
axes[1, 1].set_xlabel('Days')
axes[1, 1].legend()

axes[1, 2].hist(df['age'], bins=15, color='lightblue')
axes[1, 2].set_title('Age Distribution')
axes[1, 2].set_xlabel('Age (years)')

plt.tight_layout()
plt.show()

print("✓ Exploratory Analysis Complete")
